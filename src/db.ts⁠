import neo4j from 'neo4j-driver';
import dotenv from 'dotenv';

dotenv.config();

const uri = process.env.NEO4J_URI || '';
const user = process.env.NEO4J_USER || '';
const password = process.env.NEO4J_PASSWORD || '';

// Clean up URI to use direct bolt protocol without cluster routing parameters
let cleanUri = uri;
if (cleanUri.includes('+s://')) {
    cleanUri = cleanUri.replace('neo4j+s://', 'bolt+s://');
}

// We use direct connection settings tailored for Neo4j Aura single instances
export const driver = neo4j.driver(cleanUri, neo4j.auth.basic(user, password), {
    encrypted: 'ENCRYPTION_ON',
    trust: 'TRUST_ALL_CERTIFICATES',
    // Disable routing completely to prevent "No routing servers available"
    connectionAcquisitionTimeout: 10000,
});

export async function testConnection() {
    try {
        const session = driver.session({ database: 'neo4j' });
        const result = await session.run('RETURN 1 AS val');
        console.log('Neo4j Connected Successfully:', result.records[0].get('val'));
        await session.close();
    } catch (error) {
        console.error('Neo4j Connection Error:', error);
    }
}
