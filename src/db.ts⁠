import neo4j from 'neo4j-driver';
import dotenv from 'dotenv';

dotenv.config();

let uri = process.env.NEO4J_URI || '';
const user = process.env.NEO4J_USER || '';
const password = process.env.NEO4J_PASSWORD || '';

// Automatically force direct bolt connection to completely avoid routing discovery errors in cloud hosting
if (uri.startsWith('neo4j+s://')) {
    uri = uri.replace('neo4j+s://', 'bolt+s://');
} else if (uri.startsWith('neo4j://')) {
    uri = uri.replace('neo4j://', 'bolt://');
}

export const driver = neo4j.driver(uri, neo4j.auth.basic(user, password), {
    encrypted: 'ENCRYPTION_ON',
    trust: 'TRUST_ALL_CERTIFICATES',
    disableLosslessIntegers: true,
});

export async function testConnection() {
    try {
        const session = driver.session();
        const result = await session.run('RETURN 1 AS result');
        console.log('Neo4j Aura Connected Successfully:', result.records[0].get('result'));
        await session.close();
    } catch (error) {
        console.error('Failed to connect to Neo4j Aura:', error);
    }
}

